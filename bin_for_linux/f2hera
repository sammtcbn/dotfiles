#!/bin/bash
# Send file to remote server
# set -e
ME=$(basename "$0")
CONFIG_FILE="${HOME}/.config/.${ME}"

ip=""
userid=""
pw=""
rootpw=""
destpath=""

sshparameter="-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null"

function usage() {
    echo "Usage: ${ME} [file1] [file2] [folder1] [folder2] ..."
    exit 1
}

function cmd_exists ()
{
    if ! type "$1" > /dev/null 2>&1; then
        return 1
    else
        return 0
    fi
}

function remote_exec ()
{
    if cmd_exists sshpass && [[ -n "${pw}" ]]; then
        #sshpass -p ${pw} ssh ${sshparameter} ${userid}@${ip} "${@}"
        SSHPASS="${pw}" sshpass -e ssh ${sshparameter} "${userid}@${ip}" "$@"
    else
        ssh ${sshparameter} "${userid}@${ip}" "${@}"
    fi
}

function remote_root_exec ()
{
    if [[ -z "${rootpw}" ]]; then
        echo "Error: rootpw is not set."
        return 1
    fi
    SSHPASS="${pw}" sshpass -e ssh ${sshparameter} "${userid}@${ip}" "echo ${rootpw} | sudo -S ${@}"
}

function install_to_remote ()
{
    local src="$1"

    if [[ ! -e "${src}" ]]; then
        echo "Warning: ${src} not found, skipping..."
        return 1
    fi

    remote_exec mkdir -p "${destpath}"

    echo "Transferring: ${src} -> ${userid}@${ip}:${destpath}"

    if [[ -d "${src}" ]]; then
        if cmd_exists sshpass && [[ -n "${pw}" ]]; then
            SSHPASS="${pw}" sshpass -e scp ${sshparameter} -r "${src}" "${userid}@${ip}:${destpath}"
        else
            scp ${sshparameter} -r "$src" "${userid}@${ip}:${destpath}"
        fi
    elif [[ -f "${src}" ]]; then
        if cmd_exists sshpass && [[ -n "${pw}" ]]; then
            SSHPASS="${pw}" sshpass -e scp ${sshparameter} "${src}" "${userid}@${ip}:${destpath}"
        else
            scp ${sshparameter} "${src}" "${userid}@${ip}:${destpath}"
        fi
    fi
}

function load_config() {
    local cfg_ip="" cfg_userid="" cfg_pw="" cfg_rootpw="" cfg_destpath=""

    if [[ -f "${CONFIG_FILE}" ]]; then
        while IFS='=' read -r key value; do
            key=$(echo "$key" | tr -d '\r')
            value=$(echo "$value" | tr -d '\r')

            [[ -z "$key" || "$key" =~ ^# ]] && continue
            case "$key" in
                IP) cfg_ip="$value" ;;
                ID) cfg_userid="$value" ;;
                PW) cfg_pw="$value" ;;
                ROOTPW) cfg_rootpw="$value" ;;
                DEST) cfg_destpath="$value" ;;
            esac
        done < "${CONFIG_FILE}"
    fi

    ip="${ip:-$cfg_ip}"
    userid="${userid:-$cfg_userid}"
    pw="${pw:-$cfg_pw}"
    rootpw="${rootpw:-$cfg_rootpw}"
    destpath="${destpath:-$cfg_destpath}"

    # 逐一判斷必要變數
    if [[ -z "${ip}" ]]; then
        echo "Error: Missing required parameter: IP"
        exit 1
    fi

    if [[ -z "${userid}" ]]; then
        echo "Error: Missing required parameter: ID"
        exit 1
    fi

    if [[ -z "${pw}" ]]; then
        echo "Error: Missing required parameter: PW"
        exit 1
    fi

    if [[ -z "${destpath}" ]]; then
        if [[ "${userid}" == "root" ]]; then
            destpath="/root"
        else
            destpath="/home/${userid}"
        fi
    fi
}

function show_var()
{
    echo "config file is ${CONFIG_FILE}"
    echo "ip = ${ip}"
    echo "userid = ${userid}"
    echo "pw = ${pw}"
    echo "rootpw = ${rootpw}"
    echo "destpath = ${destpath}"
}

if [[ $# -eq 0 ]]; then
    usage
fi

load_config
#show_var

echo "Target is ${userid}@${ip}:${destpath}"

for f in "$@"; do
    install_to_remote "$f"
done

echo "Done!"
